                this simply gives us permission to use and redistribute your contributions as
                part of the project. Head over to &lt;https://cla.developers.google.com/&gt; to see
                your current agreements on file or to sign a new one.
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>